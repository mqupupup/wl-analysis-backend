
"""
V2 评分引擎 — 连续评分 + Safety Gate + 错误聚类
ExerciseSpecificScorerV2
"""

from typing import List, Dict, Any, Optional, Tuple
from dataclasses import dataclass, field
import numpy as np
import math


# ================================================================
# 数据结构
# ================================================================

@dataclass
class KeyPointScore:
    """单个评分维度的结果"""
    key_point_id: str
    name_zh: str
    name_en: str
    weight: float
    raw_value: float            # 原始测量值（如角度、偏移百分比）
    score: float                # 连续评分后的分数 0-100
    score_key: str              # 匹配的 score_map key
    details: Dict[str, Any] = field(default_factory=dict)


@dataclass
class ErrorCluster:
    """错误聚类"""
    cluster_id: str             # 聚类 ID（如 "elbow_flare_group"）
    root_cause: str             # 根因描述
    errors: List[Dict]          # 属于该聚类的错误列表
    max_penalty: float          # 该聚类最大扣分
    total_penalty_if_separate: float  # 如果不聚类，总扣分
    actual_penalty: float       # 实际扣分（取最大 + 衰减）


@dataclass
class SafetyGate:
    """安全门控"""
    gate_triggered: bool
    gate_level: str             # "severe", "moderate", "none"
    score_cap: float            # 分数上限
    trigger_errors: List[str]   # 触发门控的错误列表


@dataclass
class LayerScore:
    """四层评分中某一层的得分"""
    layer_name: str
    layer_name_zh: str
    weight: float
    raw_score: float            # 该层原始分
    gated_score: float          # 经门控后的分数
    sub_scores: List[KeyPointScore]
    error_clusters: List[ErrorCluster]


@dataclass
class RepQualityResult:
    """单个 rep 的质量评分结果"""
    rep_index: int
    total_score: float
    layer_scores: List[LayerScore]
    safety_gate: SafetyGate
    key_point_scores: List[KeyPointScore]
    errors: List[Dict]
    error_clusters: List[ErrorCluster]
    feedback_zh: str
    feedback_en: str


# ================================================================
# 连续评分函数库
# ================================================================

class ContinuousScoring:
    """
    连续评分函数库
    替代离散阈值打分，使用 Sigmoid/Gaussian/Linear 映射
    """

    @staticmethod
    def sigmoid_penalty(
        value: float,
        threshold: float,
        steepness: float = 1.0,
        max_score: float = 100.0,
        min_score: float = 0.0
    ) -> float:
        """
        Sigmoid 衰减评分
        
        当 value 接近 threshold 时，分数平滑过渡
        不会出现 4.9% → 100, 5.1% → 80 的跳崖
        
        Args:
            value: 实际测量值
            threshold: 理想阈值（超过后开始扣分）
            steepness: 衰减陡峭度（越大衰减越陡）
            max_score: 最高分
            min_score: 最低分
        
        示例（steepness=0.5, threshold=5）:
            0%  → 100
            3%  → 97
            5%  → 73
            7%  → 50
            10% → 27
            15% → 5
        """
        score_range = max_score - min_score
        # 标准化到 0-1
        normalized = 1.0 / (1.0 + math.exp(steepness * (value - threshold)))
        return min_score + score_range * normalized

    @staticmethod
    def gaussian_score(
        value: float,
        ideal: float,
        sigma: float,
        max_score: float = 100.0,
        min_score: float = 0.0
    ) -> float:
        """
        Gaussian 钟形评分
        
        值越接近 ideal，分数越高
        适合有"最佳区间"的指标（如 tempo、角度）
        
        Args:
            value: 实际测量值
            ideal: 理想值
            sigma: 标准差（控制宽容度）
        
        示例（ideal=2.0s, sigma=0.8, 离心时间）:
            2.0s → 100
            1.5s → 80
            1.0s → 54
            0.5s → 24
            3.0s → 61
        """
        score_range = max_score - min_score
        gaussian = math.exp(-0.5 * ((value - ideal) / sigma) ** 2)
        return min_score + score_range * gaussian

    @staticmethod
    def piecewise_linear(
        value: float,
        points: List[Tuple[float, float]]
    ) -> float:
        """
        分段线性插值（平滑版离散评分）
        
        points: [(value1, score1), (value2, score2), ...]
        在点之间做线性插值，而不是跳崖
        
        示例:
            points = [(0, 100), (5, 95), (10, 80), (15, 60), (25, 20)]
            4.9% → 95.2  (而不是 100)
            5.1% → 94.7  (而不是 80)
            平滑过渡！
        """
        if value <= points[0][0]:
            return points[0][1]
        if value >= points[-1][0]:
            return points[-1][1]
        
        for i in range(len(points) - 1):
            x0, y0 = points[i]
            x1, y1 = points[i + 1]
            if x0 <= value <= x1:
                ratio = (value - x0) / (x1 - x0) if x1 != x0 else 0
                return y0 + ratio * (y1 - y0)
        
        return points[-1][1]

    @staticmethod
    def capped_linear(
        value: float,
        ideal: float,
        tolerance: float,
        decay_rate: float,
        max_score: float = 100.0,
        min_score: float = 0.0
    ) -> float:
        """
        带容忍区间的线性衰减
        
        在 [ideal-tolerance, ideal+tolerance] 内满分
        超出后线性衰减
        
        示例（ideal=90°, tolerance=5°, decay_rate=3）:
            85-95° → 100
            100°   → 85
            110°   → 55
            120°   → 25
        """
        deviation = abs(value - ideal)
        if deviation <= tolerance:
            return max_score
        excess = deviation - tolerance
        score = max_score - decay_rate * excess
        return max(min_score, score)


# ================================================================
# 错误聚类器
# ================================================================

class ErrorClusterer:
    """
    错误聚类器
    将同源错误归组，避免 Double/Triple Counting
    """

    # 错误根因聚类定义
    # key = cluster_id, value = 属于该聚类的错误 ID 列表
    CLUSTER_DEFINITIONS = {
        "elbow_flare_group": {
            "root_cause": "肘部过度外展",
            "error_ids": [
                "elbow_flare_90",
                "elbow_flare_80",
                "bar_path_deviation",
                "touch_point_high",
                "shoulder_stress",
                "elbow_tuck_poor",
            ],
            "max_penalty": 35.0,
        },
        "hip_lift_group": {
            "root_cause": "臀部离凳",
            "error_ids": [
                "hip_lift_severe",
                "hip_lift_moderate",
                "excessive_arch",
                "butt_off_bench",
            ],
            "max_penalty": 40.0,
        },
        "depth_issue_group": {
            "root_cause": "深度不足/控制不当",
            "error_ids": [
                "quarter_squat",
                "insufficient_depth",
                "hip_above_knee",
                "no_pause_bounce",
                "too_fast_eccentric",
            ],
            "max_penalty": 30.0,
        },
        "bar_control_group": {
            "root_cause": "杠铃轨迹控制差",
            "error_ids": [
                "bar_path_deviation",
                "bar_drift",
                "bar_not_over_shoulders",
                "bar_midpoint_instability",
            ],
            "max_penalty": 25.0,
        },
        "asymmetry_group": {
            "root_cause": "左右不对称",
            "error_ids": [
                "asymmetric_press",
                "left_right_imbalance",
                "uneven_lockout",
                "grip_asymmetry",
            ],
            "max_penalty": 25.0,
        },
        "tempo_group": {
            "root_cause": "节奏/速度控制不当",
            "error_ids": [
                "too_fast_eccentric",
                "too_slow_concentric",
                "no_pause",
                "bounce_off_chest",
                "uncontrolled_descent",
            ],
            "max_penalty": 20.0,
        },
        "lockout_group": {
            "root_cause": "锁定阶段问题",
            "error_ids": [
                "incomplete_lockout",
                "soft_lockout",
                "elbow_hypertextension",
            ],
            "max_penalty": 20.0,
        },
    }

    @classmethod
    def cluster_errors(cls, errors: List[Dict]) -> Tuple[List[ErrorCluster], List[Dict]]:
        """
        将错误列表聚类
        
        Returns:
            (clusters, unclustered_errors)
            clusters: 聚类后的错误组
            unclustered_errors: 不属于任何聚类的独立错误
        """
        if not errors:
            return [], []

        # 构建 error_id → cluster_id 的反向映射
        error_to_cluster = {}
        for cluster_id, cluster_def in cls.CLUSTER_DEFINITIONS.items():
            for eid in cluster_def["error_ids"]:
                # 一个错误可能属于多个聚类，取第一个
                if eid not in error_to_cluster:
                    error_to_cluster[eid] = cluster_id

        # 分组
        cluster_errors_map = {}  # cluster_id → [errors]
        unclustered = []

        for error in errors:
            error_id = cls._get_error_id(error)
            if error_id in error_to_cluster:
                cid = error_to_cluster[error_id]
                if cid not in cluster_errors_map:
                    cluster_errors_map[cid] = []
                cluster_errors_map[cid].append(error)
            else:
                unclustered.append(error)

        # 构建 ErrorCluster 对象
        clusters = []
        for cluster_id, errs in cluster_errors_map.items():
            cluster_def = cls.CLUSTER_DEFINITIONS[cluster_id]
            
            # 计算如果不聚类的总扣分
            total_if_separate = sum(
                cls._get_penalty(e) for e in errs
            )

            # 聚类扣分策略：
            # 取最大单个扣分 + 其余扣分的 30% 衰减
            penalties = sorted(
                [cls._get_penalty(e) for e in errs],
                reverse=True
            )
            actual_penalty = penalties[0]  # 最大扣分全保留
            for p in penalties[1:]:
                actual_penalty += p * 0.3  # 其余衰减 70%

            # 不超过聚类上限
            actual_penalty = min(actual_penalty, cluster_def["max_penalty"])

            clusters.append(ErrorCluster(
                cluster_id=cluster_id,
                root_cause=cluster_def["root_cause"],
                errors=errs,
                max_penalty=cluster_def["max_penalty"],
                total_penalty_if_separate=total_if_separate,
                actual_penalty=actual_penalty,
            ))

            print(f"  [CLUSTER] 🔗 {cluster_id}: "
                  f"{len(errs)} 个错误合并, "
                  f"原扣分 {total_if_separate:.1f} → 实际扣分 {actual_penalty:.1f} "
                  f"(节省 {total_if_separate - actual_penalty:.1f})")

        return clusters, unclustered

    @staticmethod
    def _get_error_id(error: Dict) -> str:
        if isinstance(error, dict):
            return error.get("id", error.get("error_id", error.get("name_en", "")))
        return getattr(error, 'id', getattr(error, 'error_id', getattr(error, 'name_en', '')))

    @staticmethod
    def _get_penalty(error: Dict) -> float:
        if isinstance(error, dict):
            return abs(float(error.get("score_penalty", 0)))
        return abs(float(getattr(error, 'score_penalty', 0)))


# ================================================================
# 四层评分引擎
# ================================================================

class LayeredScorer:
    """
    四层评分架构
    
    Level 1: Movement Quality (40%) — ROM, Velocity, Tempo, Bar Path
    Level 2: Technique (30%) — Elbow, Touch Point, Leg Drive, Grip
    Level 3: Safety (20%) — Shoulder, Lumbar, Hip Lift, Bounce
    Level 4: Performance (10%) — Explosiveness, Sticking Point, Efficiency
    
    Safety Gate: 严重安全错误 → 总分上限
    """

    # 层定义
    LAYERS = {
        "movement_quality": {
            "name_zh": "动作质量",
            "weight": 0.40,
            "key_point_ids": [
                "depth", "rom", "tempo", "bar_path",
                "velocity_profile", "range_of_motion",
                "phase_duration", "midpoint_stability",
            ],
        },
        "technique": {
            "name_zh": "技术细节",
            "weight": 0.30,
            "key_point_ids": [
                "elbow_tuck", "touch_point", "leg_drive",
                "grip_width", "scapula_retraction", "wrist_position",
                "knee_tracking", "torso_angle", "symmetry",
            ],
        },
        "safety": {
            "name_zh": "安全性",
            "weight": 0.20,
            "key_point_ids": [
                "shoulder_stress", "lumbar_stress",
                "hip_lift", "bounce", "asymmetry",
                "valgus", "spinal_alignment",
            ],
        },
        "performance": {
            "name_zh": "运动表现",
            "weight": 0.10,
            "key_point_ids": [
                "explosiveness", "sticking_point",
                "efficiency", "consistency", "power_output",
            ],
        },
    }

    # Safety Gate 定义
    # 当这些错误出现时，总分设置上限
    SAFETY_GATES = {
        "severe": {
            "score_cap": 40.0,
            "error_ids": [
                "hip_lift_severe",
                "butt_off_bench",
                "elbow_flare_90",
                "severe_valgus",
                "bar_drop",
            ],
            "description": "严重安全隐患",
        },
        "moderate": {
            "score_cap": 65.0,
            "error_ids": [
                "hip_lift_moderate",
                "elbow_flare_80",
                "moderate_valgus",
                "bounce_off_chest",
                "incomplete_lockout",
            ],
            "description": "中等安全隐患",
        },
    }

    @classmethod
    def evaluate_safety_gate(cls, errors: List[Dict]) -> SafetyGate:
        """评估安全门控"""
        triggered_errors = []
        gate_level = "none"
        score_cap = 100.0

        for error in errors:
            error_id = ErrorClusterer._get_error_id(error)

            if error_id in cls.SAFETY_GATES["severe"]["error_ids"]:
                gate_level = "severe"
                score_cap = cls.SAFETY_GATES["severe"]["score_cap"]
                triggered_errors.append(error_id)
            elif error_id in cls.SAFETY_GATES["moderate"]["error_ids"]:
                if gate_level != "severe":
                    gate_level = "moderate"
                    score_cap = cls.SAFETY_GATES["moderate"]["score_cap"]
                triggered_errors.append(error_id)

        if triggered_errors:
            print(f"  [SAFETY GATE] 🚨 {gate_level} 触发! "
                  f"总分上限 → {score_cap}, "
                  f"触发错误: {triggered_errors}")

        return SafetyGate(
            gate_triggered=gate_level != "none",
            gate_level=gate_level,
            score_cap=score_cap,
            trigger_errors=triggered_errors,
        )

    @classmethod
    def assign_key_points_to_layers(
        cls, key_point_scores: List[KeyPointScore]
    ) -> Dict[str, List[KeyPointScore]]:
        """将 key_point 评分分配到各层"""
        layer_scores = {layer: [] for layer in cls.LAYERS}
        unassigned = []

        for kps in key_point_scores:
            assigned = False
            for layer_name, layer_def in cls.LAYERS.items():
                if kps.key_point_id in layer_def["key_point_ids"]:
                    layer_scores[layer_name].append(kps)
                    assigned = True
                    break
            
            if not assigned:
                # 尝试模糊匹配
                kp_lower = kps.key_point_id.lower()
                for layer_name, layer_def in cls.LAYERS.items():
                    for lid in layer_def["key_point_ids"]:
                        if lid in kp_lower or kp_lower in lid:
                            layer_scores[layer_name].append(kps)
                            assigned = True
                            break
                    if assigned:
                        break
            
            if not assigned:
                # 未分配的放入 movement_quality（默认层）
                layer_scores["movement_quality"].append(kps)

        return layer_scores


# ================================================================
# V2 评分器主类
# ================================================================

class ExerciseSpecificScorerV2:
    """
    V2 评分引擎
    
    核心改进:
    1. 连续评分函数（Sigmoid/Gaussian/PiecewiseLinear）替代离散阈值
    2. Safety Gate 门控机制
    3. 错误聚类去重
    4. 四层评分架构
    """

    def __init__(self, knowledge: Dict[str, Any], fps: float = 30.0):
        self.knowledge = knowledge
        self.fps = fps
        self.key_points = knowledge.get("key_points", [])
        self.feedback_rules = knowledge.get("feedback_rules", {})
        self.scorer = ContinuousScoring()

    def score_reps(
        self, reps: List[Any], frame_data_list: List[Any]
    ) -> List[RepQualityResult]:
        """对所有 rep 评分"""
        return [self._score_single_rep(rep, frame_data_list) for rep in reps]

    def _score_single_rep(
        self, rep: Any, frame_data_list: List[Any]
    ) -> RepQualityResult:
        """评分单个 rep — V2 版"""
        rep_idx = rep.rep_index if hasattr(rep, 'rep_index') else '?'
        print(f"\n  [V2 SCORER] Rep#{rep_idx} 评分开始 "
              f"(frames {rep.start_frame}-{rep.end_frame})")

        # ========== Step 1: 逐维度连续评分 ==========
        key_point_scores = []
        for kp in self.key_points:
            kp_id = kp.get("id", "unknown")
            kp_name = kp.get("name_zh", "未知")
            measure = kp.get("measure", {})
            method = measure.get("method", "")
            weight = float(kp.get("weight", 0))

            print(f"  [V2]   📐 {kp_id} ({kp_name}): "
                  f"method={method}, weight={weight}")

            # 获取原始测量值
            raw_result = self._measure_key_point(kp, rep, frame_data_list)

            if raw_result is not None:
                # 连续评分（而非离散 score_map）
                continuous_score = self._continuous_score(
                    kp, raw_result
                )
                key_point_scores.append(continuous_score)
                print(f"  [V2]     → raw={raw_result.get('value', '?'):.2f}, "
                      f"score={continuous_score.score:.1f}")
            else:
                print(f"  [V2]     → 无结果（数据不足）")

        # ========== Step 2: 错误聚类 ==========
        raw_errors = rep.errors_detected if hasattr(rep, 'errors_detected') else []
        clusters, unclustered_errors = ErrorClusterer.cluster_errors(raw_errors)

        # ========== Step 3: 四层评分 ==========
        layer_assignments = LayeredScorer.assign_key_points_to_layers(
            key_point_scores
        )

        # 将错误聚类也分配到各层
        error_cluster_map = self._assign_clusters_to_layers(clusters)

        layer_scores = []
        for layer_name, layer_def in LayeredScorer.LAYERS.items():
            sub_scores = layer_assignments.get(layer_name, [])
            layer_clusters = error_cluster_map.get(layer_name, [])

            # 层内加权平均
            layer_raw = self._weighted_avg(sub_scores)

            # 层内错误扣分
            cluster_penalty = sum(c.actual_penalty for c in layer_clusters)
            layer_gated = max(0.0, layer_raw - cluster_penalty)

            layer_scores.append(LayerScore(
                layer_name=layer_name,
                layer_name_zh=layer_def["name_zh"],
                weight=layer_def["weight"],
                raw_score=layer_raw,
                gated_score=layer_gated,
                sub_scores=sub_scores,
                error_clusters=layer_clusters,
            ))

            print(f"  [V2]   📊 Layer '{layer_name}': "
                  f"raw={layer_raw:.1f}, penalty={cluster_penalty:.1f}, "
                  f"final={layer_gated:.1f}, weight={layer_def['weight']}")

        # ========== Step 4: 层间加权 → 基础总分 ==========
        total_score = sum(
            ls.gated_score * ls.weight for ls in layer_scores
        )

        # ========== Step 5: Safety Gate 门控 ==========
        safety_gate = LayeredScorer.evaluate_safety_gate(raw_errors)
        if safety_gate.gate_triggered:
            total_score = min(total_score, safety_gate.score_cap)
            print(f"  [V2]   🚨 Safety Gate 触发! "
                  f"分数上限 {safety_gate.score_cap} → 最终 {total_score:.1f}")

        # 未聚类的独立错误额外扣分（衰减后）
        unclustered_penalty = sum(
            ErrorClusterer._get_penalty(e) for e in unclustered_errors
        ) * 0.5  # 独立错误只扣 50%（因为可能已被 key_point 评分反映）
        total_score = max(0.0, total_score - unclustered_penalty)

        total_score = round(max(0.0, min(100.0, total_score)), 1)

        print(f"  [V2]   🏆 最终总分: {total_score} / 100")

        # ========== Step 6: 生成反馈 ==========
        feedback_zh, feedback_en = self._generate_feedback(
            total_score, layer_scores, safety_gate,
            clusters, unclustered_errors, rep.rep_index
        )

        return RepQualityResult(
            rep_index=rep.rep_index,
            total_score=total_score,
            layer_scores=layer_scores,
            safety_gate=safety_gate,
            key_point_scores=key_point_scores,
            errors=[
                e.to_dict() if hasattr(e, 'to_dict')
                else e if isinstance(e, dict)
                else str(e)
                for e in raw_errors
            ],
            error_clusters=clusters,
            feedback_zh=feedback_zh,
            feedback_en=feedback_en,
        )

    # ================================================================
    # 连续评分核心
    # ================================================================

    def _continuous_score(
        self, kp: Dict, raw_result: Dict
    ) -> KeyPointScore:
        """
        用连续函数替代离散 score_map
        
        优先使用 kp 中定义的 scoring_function，
        否则根据 measure.method 选择默认函数
        """
        kp_id = kp.get("id", "unknown")
        measure = kp.get("measure", {})
        method = measure.get("method", "")
        value = raw_result.get("value", 0)
        score_map = kp.get("score_map", {})

        # 检查是否有自定义评分函数定义
        scoring_fn = kp.get("scoring_function", None)

        if scoring_fn:
            score = self._apply_custom_scoring(scoring_fn, value)
        else:
            # 根据方法类型选择默认连续函数
            score = self._default_continuous_score(
                method, value, score_map, kp_id
            )

        return KeyPointScore(
            key_point_id=kp_id,
            name_zh=kp.get("name_zh", "未知"),
            name_en=kp.get("name_en", "Unknown"),
            weight=float(kp.get("weight", 0.1)),
            raw_value=value,
            score=round(score, 1),
            score_key=raw_result.get("key", "continuous"),
            details=raw_result.get("details", {}),
        )

    def _apply_custom_scoring(
        self, fn_def: Dict, value: float
    ) -> float:
        """应用自定义评分函数"""
        fn_type = fn_def.get("type", "sigmoid")

        if fn_type == "sigmoid":
            return ContinuousScoring.sigmoid_penalty(
                value=value,
                threshold=fn_def.get("threshold", 5.0),
                steepness=fn_def.get("steepness", 1.0),
                max_score=fn_def.get("max_score", 100.0),
                min_score=fn_def.get("min_score", 0.0),
            )

        elif fn_type == "gaussian":
            return ContinuousScoring.gaussian_score(
                value=value,
                ideal=fn_def.get("ideal", 0.0),
                sigma=fn_def.get("sigma", 1.0),
                max_score=fn_def.get("max_score", 100.0),
                min_score=fn_def.get("min_score", 0.0),
            )

        elif fn_type == "piecewise_linear":
            points = fn_def.get("points", [])
            if points:
                tuples = [(p["value"], p["score"]) for p in points]
                return ContinuousScoring.piecewise_linear(value, tuples)

        elif fn_type == "capped_linear":
            return ContinuousScoring.capped_linear(
                value=value,
                ideal=fn_def.get("ideal", 0.0),
                tolerance=fn_def.get("tolerance", 5.0),
                decay_rate=fn_def.get("decay_rate", 3.0),
                max_score=fn_def.get("max_score", 100.0),
                min_score=fn_def.get("min_score", 0.0),
            )

        return 50.0  # 兜底

    def _default_continuous_score(
        self, method: str, value: float,
        score_map: Dict, kp_id: str
    ) -> float:
        """
        根据 method 类型选择默认连续评分函数
        
        核心思路：
        - 如果 score_map 存在，将其转换为 piecewise_linear 的锚点
        - 如果没有 score_map，根据方法类型给默认函数
        """
        if score_map:
            # 将离散 score_map 转换为连续锚点
            # 例如: {"0-5%": 100, "5-10%": 80, "10-15%": 60, ">15%": 35}
            # → [(0, 100), (5, 90), (10, 70), (15, 47), (25, 20)]
            points = self._score_map_to_continuous(score_map)
            if points:
                return ContinuousScoring.piecewise_linear(value, points)

        # 无 score_map 时的默认函数
        method_defaults = {
            "compare_y": lambda v: ContinuousScoring.sigmoid_penalty(
                v, threshold=5.0, steepness=0.3
            ),
            "compare_x": lambda v: ContinuousScoring.sigmoid_penalty(
                v, threshold=5.0, steepness=0.4
            ),
            "angle": lambda v: ContinuousScoring.capped_linear(
                v, ideal=0.0, tolerance=10.0, decay_rate=2.0
            ),
            "velocity_comparison": lambda v: ContinuousScoring.gaussian_score(
                v, ideal=1.0, sigma=0.3
            ),
            "midpoint_x_std": lambda v: ContinuousScoring.sigmoid_penalty(
                v, threshold=5.0, steepness=0.3
            ),
            "compare_sides": lambda v: ContinuousScoring.sigmoid_penalty(
                v, threshold=8.0, steepness=0.2
            ),
            "phase_duration_ratio": lambda v: ContinuousScoring.gaussian_score(
                v, ideal=2.0, sigma=1.0
            ),
        }

        fn = method_defaults.get(method)
        if fn:
            return fn(value)

        # 最终兜底
        return ContinuousScoring.sigmoid_penalty(
            value, threshold=10.0, steepness=0.2
        )

    def _score_map_to_continuous(
        self, score_map: Dict
    ) -> List[Tuple[float, float]]:
        """
        将离散 score_map 转换为连续锚点
        
        输入: {"0-5%": 100, "5-10%": 80, "10-15%": 60, ">15%": 35}
        输出: [(0, 100), (2.5, 100), (7.5, 80), (12.5, 60), (20, 35)]
        
        在锚点之间自动线性插值，消除跳崖
        """
        points = []
        for key, score in score_map.items():
            if not isinstance(score, (int, float)):
                continue

            # 解析 key 中的数值范围
            key_str = str(key)
            numbers = self._extract_numbers(key_str)

            if len(numbers) >= 2:
                # 有范围：取中点作为锚点
                mid = (numbers[0] + numbers[1]) / 2
                points.append((mid, float(score)))
            elif len(numbers) == 1:
                points.append((numbers[0], float(score)))

        # 按 value 排序
        points.sort(key=lambda x: x[0])
        return points

    @staticmethod
    def _extract_numbers(s: str) -> List[float]:
        """从字符串中提取数字"""
        import re
        matches = re.findall(r'[\d.]+', s)
        return [float(m) for m in matches]

    # ================================================================
    # 测量方法（从 V1 继承并增强）
    # ================================================================

    def _measure_key_point(
        self, kp: Dict, rep: Any, frame_data_list: List[Any]
    ) -> Optional[Dict]:
        """
        测量单个维度的原始值
        
        与 V1 的区别：返回连续数值而非离散 key
        """
        measure = kp.get("measure", {})
        method = measure.get("method", "")

        scorer_method = getattr(self, f"_measure_{method}", None)
        if scorer_method:
            return scorer_method(measure, rep, frame_data_list)

        return self._measure_generic(measure, rep, frame_data_list)

    def _measure_compare_y(
        self, measure: Dict, rep: Any, frame_data_list: List[Any]
    ) -> Optional[Dict]:
        """测量 Y 坐标差值（返回连续数值）"""
        points = measure.get("points", [])
        at_phase = measure.get("at_phase", "")

        if len(points) < 2:
            return None

        target_frames = self._get_phase_frames(rep, at_phase, frame_data_list)
        if not target_frames:
            return None

        diffs = []
        for frame_idx, fd in target_frames:
            positions = fd.positions if hasattr(fd, 'positions') else {}
            p1_y = self._get_avg_y(positions, points[0])
            p2_y = self._get_avg_y(positions, points[1])
            if p1_y is not None and p2_y is not None:
                body_height = self._estimate_body_height(positions)
                if body_height > 0:
                    diff_pct = abs(p1_y - p2_y) / body_height * 100
                    diffs.append(diff_pct)

        if not diffs:
            return None

        avg_diff = float(np.mean(diffs))
        return {
            "key": "y_deviation_pct",
            "value": avg_diff,
            "details": {"avg_deviation_pct": avg_diff, "frames": len(diffs)},
        }

    def _measure_compare_x(
        self, measure: Dict, rep: Any, frame_data_list: List[Any]
    ) -> Optional[Dict]:
        """测量 X 坐标差值（返回连续数值）"""
        points = measure.get("points", [])
        at_phases = measure.get("at_phase", [])

        if len(points) < 2:
            return None

        if isinstance(at_phases, str):
            at_phases = [at_phases]

        all_frames = []
        for phase in at_phases:
            all_frames.extend(self._get_phase_frames(rep, phase, frame_data_list))

        if not all_frames:
            return None

        deviations = []
        for frame_idx, fd in all_frames:
            positions = fd.positions if hasattr(fd, 'positions') else {}
            p1_x = self._get_avg_x(positions, points[0])
            p2_x = self._get_avg_x(positions, points[1])
            if p1_x is not None and p2_x is not None:
                shoulder_width = self._get_shoulder_width(positions)
                deviation = abs(p1_x - p2_x) / shoulder_width * 100 if shoulder_width > 0 else 0
                deviations.append(deviation)

        if not deviations:
            return None

        avg_dev = float(np.mean(deviations))
        return {
            "key": "x_deviation_pct",
            "value": avg_dev,
            "details": {"avg_deviation_pct": avg_dev, "frames": len(deviations)},
        }

    def _measure_angle(
        self, measure: Dict, rep: Any, frame_data_list: List[Any]
    ) -> Optional[Dict]:
        """测量角度（返回连续数值）"""
        points = measure.get("points", [])
        at_phase = measure.get("at_phase", "")

        target_frames = self._get_phase_frames(rep, at_phase, frame_data_list)
        if not target_frames:
            return None

        angles = []
        for frame_idx, fd in target_frames:
            fd_angles = fd.angles if hasattr(fd, 'angles') else {}
            angle_key = measure.get("angle_key", "torso_from_vertical")
            if angle_key in fd_angles:
                angles.append(fd_angles[angle_key])

        if not angles:
            return None

        avg_angle = float(np.mean(angles))
        return {
            "key": "angle_value",
            "value": avg_angle,
            "details": {"avg_angle": avg_angle, "frames": len(angles)},
        }

    def _measure_velocity_comparison(
        self, measure: Dict, rep: Any, frame_data_list: List[Any]
    ) -> Optional[Dict]:
        """测量速度比（返回连续数值）"""
        points = measure.get("points", [])
        at_phase = measure.get("at_phase", "")

        target_frames = self._get_phase_frames(rep, at_phase, frame_data_list)
        if len(target_frames) < 5:
            return None

        point1_ys = []
        point2_ys = []

        for frame_idx, fd in target_frames:
            positions = fd.positions if hasattr(fd, 'positions') else {}
            p1_y = self._get_avg_y(positions, points[0]) if points else None
            p2_y = self._get_avg_y(positions, points[1]) if len(points) > 1 else None
            if p1_y is not None and p2_y is not None:
                point1_ys.append(p1_y)
                point2_ys.append(p2_y)

        if len(point1_ys) < 5:
            return None

        v1 = np.abs(np.diff(point1_ys))
        v2 = np.abs(np.diff(point2_ys))

        mean_v2 = np.mean(v2)
        if mean_v2 == 0:
            return None

        ratio = float(np.mean(v1) / mean_v2)
        return {
            "key": "velocity_ratio",
            "value": ratio,
            "details": {"ratio": ratio, "v1_mean": float(np.mean(v1)), "v2_mean": mean_v2},
        }

    def _measure_midpoint_x_std(
        self, measure: Dict, rep: Any, frame_data_list: List[Any]
    ) -> Optional[Dict]:
        """测量中点 X 标准差（返回连续数值）"""
        at_phases = measure.get("at_phase", [])
        if isinstance(at_phases, str):
            at_phases = [at_phases]

        all_frames = []
        for phase in at_phases:
            all_frames.extend(self._get_phase_frames(rep, phase, frame_data_list))

        if len(all_frames) < 5:
            return None

        midpoint_xs = []
        for frame_idx, fd in all_frames:
            positions = fd.positions if hasattr(fd, 'positions') else {}
            lw = positions.get("left_wrist")
            rw = positions.get("right_wrist")
            if lw and rw:
                mid_x = (lw[0] + rw[0]) / 2
                midpoint_xs.append(mid_x)

        if len(midpoint_xs) < 5:
            return None

        std = float(np.std(midpoint_xs))
        mean = float(np.mean(midpoint_xs))
        cv_pct = (std / mean * 100) if mean > 0 else 0

        return {
            "key": "midpoint_cv_pct",
            "value": cv_pct,
            "details": {"cv_pct": cv_pct, "std": std, "mean": mean},
        }

    def _measure_compare_sides(
        self, measure: Dict, rep: Any, frame_data_list: List[Any]
    ) -> Optional[Dict]:
        """测量左右对称性（返回连续数值）"""
        points = measure.get("points", [])
        at_phases = measure.get("at_phase", [])

        if isinstance(at_phases, str):
            at_phases = [at_phases]

        all_frames = []
        for phase in at_phases:
            all_frames.extend(self._get_phase_frames(rep, phase, frame_data_list))

        if not all_frames:
            return None

        diffs = []
        for frame_idx, fd in all_frames:
            angles = fd.angles if hasattr(fd, 'angles') else {}
            for point_pair in points:
                if point_pair in angles:
                    if point_pair.startswith("left_"):
                        right_key = "right_" + point_pair[5:]
                        if right_key in angles:
                            diffs.append(abs(angles[point_pair] - angles[right_key]))

        if not diffs:
            return None

        avg_diff = float(np.mean(diffs))
        return {
            "key": "symmetry_diff",
            "value": avg_diff,
            "details": {"avg_diff": avg_diff, "frames": len(diffs)},
        }

    def _measure_phase_duration_ratio(
        self, measure: Dict, rep: Any, frame_data_list: List[Any]
    ) -> Optional[Dict]:
        """测量阶段时长比（返回连续数值）"""
        if not hasattr(rep, 'phases') or not rep.phases:
            return None

        phase_durations = {}
        for phase in rep.phases:
            phase_durations[phase.phase_name] = phase.duration

        ecc_dur = phase_durations.get("eccentric", 0)
        con_dur = phase_durations.get("concentric", 0)
        pause_dur = phase_durations.get("bottom_pause", 0) or phase_durations.get("bottom", 0)

        # 返回离心时间作为主要指标
        value = ecc_dur if ecc_dur > 0 else con_dur
        return {
            "key": "eccentric_duration",
            "value": value,
            "details": {
                "eccentric": ecc_dur,
                "concentric": con_dur,
                "pause": pause_dur,
            },
        }

    def _measure_generic(
        self, measure: Dict, rep: Any, frame_data_list: List[Any]
    ) -> Optional[Dict]:
        """通用测量兜底"""
        return {"key": "default", "value": 0.0, "details": {}}

    # ================================================================
    # 辅助方法
    # ================================================================

    def _weighted_avg(self, scores: List[KeyPointScore]) -> float:
        """加权平均"""
        total_weighted = 0.0
        total_weight = 0.0
        for kps in scores:
            total_weighted += kps.score * kps.weight
            total_weight += kps.weight
        return total_weighted / total_weight if total_weight > 1e-6 else 50.0

    def _assign_clusters_to_layers(
        self, clusters: List[ErrorCluster]
    ) -> Dict[str, List[ErrorCluster]]:
        """将错误聚类分配到对应的层"""
        layer_clusters = {layer: [] for layer in LayeredScorer.LAYERS}

        # 聚类 → 层的映射
        cluster_to_layer = {
            "elbow_flare_group": "technique",
            "hip_lift_group": "safety",
            "depth_issue_group": "movement_quality",
            "bar_control_group": "movement_quality",
            "asymmetry_group": "safety",
            "tempo_group": "movement_quality",
            "lockout_group": "performance",
        }

        for cluster in clusters:
            layer = cluster_to_layer.get(
                cluster.cluster_id, "movement_quality"
            )
            layer_clusters[layer].append(cluster)

        return layer_clusters

    def _generate_feedback(
        self,
        total_score: float,
        layer_scores: List[LayerScore],
        safety_gate: SafetyGate,
        clusters: List[ErrorCluster],
        unclustered_errors: List[Dict],
        rep_index: int,
    ) -> Tuple[str, str]:
        """生成 V2 反馈"""
        # 找到最弱的层
        weakest_layer = min(layer_scores, key=lambda l: l.gated_score)

        # 安全门控优先提示
        if safety_gate.gate_triggered:
            gate_desc = "严重安全隐患" if safety_gate.gate_level == "severe" else "中等安全隐患"
            feedback_zh = (
                f"⚠️ Rep#{rep_index} 检测到{gate_desc}，"
                f"总分限制在 {safety_gate.score_cap} 分以下。"
                f"触发原因: {', '.join(safety_gate.trigger_errors)}。"
                f"最弱环节: {weakest_layer.layer_name_zh}"
                f"({weakest_layer.gated_score:.0f}分)。"
            )
            feedback_en = (
                f"⚠️ Rep#{rep_index} {gate_desc} detected, "
                f"score capped at {safety_gate.score_cap}. "
                f"Triggered by: {', '.join(safety_gate.trigger_errors)}. "
                f"Weakest area: {weakest_layer.layer_name} "
                f"({weakest_layer.gated_score:.0f})."
            )
        else:
            feedback_zh = (
                f"Rep#{rep_index} 总分 {total_score} 分。"
                f"最弱环节: {weakest_layer.layer_name_zh}"
                f"({weakest_layer.gated_score:.0f}分)。"
            )
            feedback_en = (
                f"Rep#{rep_index} scored {total_score}/100. "
                f"Weakest area: {weakest_layer.layer_name} "
                f"({weakest_layer.gated_score:.0f})."
            )

        # 添加聚类信息
        if clusters:
            cluster_info = ", ".join(
                f"{c.root_cause}(扣{c.actual_penalty:.0f}分，"
                f"合并{len(c.errors)}个错误)"
                for c in clusters
            )
            feedback_zh += f" 错误聚类: {cluster_info}。"

        return feedback_zh, feedback_en

    # ================================================================
    # Phase 帧获取（含别名支持 — 修复 V1 Bug）
    # ================================================================

    PHASE_ALIASES = {
        "bottom": ["bottom_pause", "bottom", "pause"],
        "bottom_pause": ["bottom_pause", "bottom", "pause"],
        "eccentric": ["eccentric", "descent", "lowering"],
        "concentric": ["concentric", "ascent", "lifting", "press"],
        "lockout": ["lockout", "top", "finish"],
        "setup": ["setup", "start", "ready"],
        "rest": ["rest", "idle", "recovery"],
    }

    def _get_phase_frames(
        self, rep: Any, phase_name: str, frame_data_list: List[Any]
    ) -> List[Tuple[int, Any]]:
        """获取指定阶段的帧 — 支持别名"""
        frames = []

        # 获取所有可能的别名
        aliases = self.PHASE_ALIASES.get(phase_name, [phase_name])

        if hasattr(rep, 'phases') and rep.phases:
            for phase in rep.phases:
                if phase.phase_name in aliases:
                    for i in range(phase.start_frame, phase.end_frame + 1):
                        if i < len(frame_data_list):
                            frames.append((i, frame_data_list[i]))
        else:
            for i in range(rep.start_frame, rep.end_frame + 1):
                if i < len(frame_data_list):
                    frames.append((i, frame_data_list[i]))

        return frames

    def _get_avg_y(self, positions: Dict, point: str) -> Optional[float]:
        left = positions.get(f"left_{point}")
        right = positions.get(f"right_{point}")
        ys = []
        if left:
            ys.append(left[1])
        if right:
            ys.append(right[1])
        return float(np.mean(ys)) if ys else None

    def _get_avg_x(self, positions: Dict, point: str) -> Optional[float]:
        left = positions.get(f"left_{point}")
        right = positions.get(f"right_{point}")
        xs = []
        if left:
            xs.append(left[0])
        if right:
            xs.append(right[0])
        return float(np.mean(xs)) if xs else None

    def _get_shoulder_width(self, positions: Dict) -> float:
        ls = positions.get("left_shoulder")
        rs = positions.get("right_shoulder")
        if ls and rs:
            return abs(ls[0] - rs[0])
        return 100

    def _estimate_body_height(self, positions: Dict) -> float:
        shoulder_y = self._get_avg_y(positions, "shoulder")
        ankle_y = self._get_avg_y(positions, "ankle")
        if shoulder_y is not None and ankle_y is not None:
            return abs(ankle_y - shoulder_y) * 1.15
        return 500


# ================================================================
# 结果格式化函数 - 将 V2 评分结果转换为前端友好的 JSON 格式
# ================================================================

def format_v2_results_for_frontend(rep_results_v2: list) -> list:
    """将 V2 评分结果转换为前端友好的 JSON 格式"""
    formatted_reps = []

    for res in rep_results_v2:
        # 1. 提取四层评分详情
        layers_detail = []
        for layer in res.layer_scores:
            layers_detail.append({
                "layer_name": layer.layer_name,
                "layer_name_zh": layer.layer_name_zh,
                "weight": layer.weight,
                "score": round(layer.gated_score, 1),
                "sub_scores": [
                    {
                        "id": kp.key_point_id,
                        "name": kp.name_zh,
                        "score": kp.score,
                        "raw_value": round(kp.raw_value, 2)
                    } for kp in layer.sub_scores
                ]
            })

        # 2. 提取错误聚类信息
        clusters_detail = []
        for cluster in res.error_clusters:
            clusters_detail.append({
                "cluster_id": cluster.cluster_id,
                "root_cause": cluster.root_cause,
                "actual_penalty": round(cluster.actual_penalty, 1),
                "merged_errors_count": len(cluster.errors),
                "saved_penalty": round(cluster.total_penalty_if_separate - cluster.actual_penalty, 1)
            })

        # 3. 组装单个 Rep 的最终 JSON
        rep_json = {
            "rep_index": res.rep_index,
            "total_score": res.total_score,
            "feedback_zh": res.feedback_zh,
            "feedback_en": res.feedback_en,

            # V2 新增核心字段
            "safety_gate": {
                "triggered": res.safety_gate.gate_triggered,
                "level": res.safety_gate.gate_level,
                "score_cap": res.safety_gate.score_cap,
                "trigger_errors": res.safety_gate.trigger_errors
            },
            "layers": layers_detail,
            "error_clusters": clusters_detail,

            # 保留原始错误列表（供debug或详细展示使用）
            "raw_errors": res.errors
        }
        formatted_reps.append(rep_json)

    return formatted_reps