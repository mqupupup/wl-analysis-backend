"""
生物力学质量分析模块
包含动作切分、质量评分和疲劳分析
"""
import numpy as np
from typing import List, Dict, Any

import types


class StateMachineRepSegmenter:
    """基于状态机的动作次数（Rep）切分器"""

    def __init__(self, fps: float = 30.0, exercise: str = "unknown", min_rep_duration: float = 0.8):
        self.fps = fps
        self.exercise = exercise.lower()
        self.min_rep_duration = min_rep_duration
        self.states = ['resting', 'eccentric', 'concentric', 'lockout']

    def segment(self, frame_data_list: list) -> list:
        """
        根据帧数据列表切分每一次动作
        兼容 dict 和 FramePoseData 对象
        """
        reps = []

        if not frame_data_list or len(frame_data_list) < 3:
            return reps

        timestamps = []
        knee_angles = []
        elbow_angles = []
        shoulder_flexion_angles = []  # ✅ 新增：肩屈曲角（OHP 用）

        for idx, frame in enumerate(frame_data_list):
            # 1. 兼容获取时间戳
            if isinstance(frame, dict):
                t = frame.get('timestamp') or frame.get('time') or frame.get('t', 0.0)
                if t == 0.0 and 'frame_idx' in frame:
                    t = frame['frame_idx'] / self.fps
                angles_dict = frame.get('angles', frame.get('joint_angles', {}))
            else:
                t = getattr(frame, 'timestamp', getattr(frame, 'time', getattr(frame, 't', 0.0)))
                if t == 0.0 and hasattr(frame, 'frame_idx'):
                    t = frame.frame_idx / self.fps

                angles_obj = getattr(frame, 'angles', getattr(frame, 'joint_angles', {}))
                if hasattr(angles_obj, '__dict__') and not isinstance(angles_obj, dict):
                    angles_dict = vars(angles_obj)
                elif isinstance(angles_obj, dict):
                    angles_dict = angles_obj
                else:
                    angles_dict = {}

            timestamps.append(float(t) if t else idx / self.fps)

            # 2. ✅ 修复：兼容获取关节角度 — 匹配 FramePoseData 的实际 key 名称
            if isinstance(angles_dict, dict):
                # 膝盖角：left_knee / right_knee（FramePoseData 实际 key）
                knee = (
                    angles_dict.get('left_knee')
                    or angles_dict.get('right_knee')
                    or angles_dict.get('knee')
                    or angles_dict.get('knee_left')
                    or angles_dict.get('knee_angle', 180)
                )
                # 肘角：left_elbow / right_elbow
                elbow = (
                    angles_dict.get('left_elbow')
                    or angles_dict.get('right_elbow')
                    or angles_dict.get('elbow')
                    or angles_dict.get('elbow_left')
                    or angles_dict.get('elbow_angle', 180)
                )
                # ✅ 新增：肩屈曲角（用于 OHP）
                shoulder_flex = (
                    angles_dict.get('left_shoulder_flexion')
                    or angles_dict.get('right_shoulder_flexion')
                    or angles_dict.get('shoulder_flexion', 180)
                )
            else:
                knee = 180
                elbow = 180
                shoulder_flex = 180

            knee_angles.append(float(knee) if knee else 180)
            elbow_angles.append(float(elbow) if elbow else 180)
            shoulder_flexion_angles.append(float(shoulder_flex) if shoulder_flex else 180)

        # ✅ 修复：根据运动类型选择主要关节角度
        if 'squat' in self.exercise or 'deadlift' in self.exercise:
            angles = knee_angles
        elif 'bench' in self.exercise:
            angles = elbow_angles
        elif 'overhead' in self.exercise or 'press' in self.exercise or 'ohp' in self.exercise:
            # ✅ OHP：优先用肩屈曲角，如果变化不够大则用肘角
            shoulder_var = max(shoulder_flexion_angles) - min(shoulder_flexion_angles) if shoulder_flexion_angles else 0
            elbow_var = max(elbow_angles) - min(elbow_angles) if elbow_angles else 0
            if shoulder_var >= 15:  # 肩屈曲角变化够大
                angles = shoulder_flexion_angles
            else:
                angles = elbow_angles
        else:
            knee_var = max(knee_angles) - min(knee_angles) if knee_angles else 0
            elbow_var = max(elbow_angles) - min(elbow_angles) if elbow_angles else 0
            shoulder_var = max(shoulder_flexion_angles) - min(shoulder_flexion_angles) if shoulder_flexion_angles else 0
            # 选变化最大的
            vars_map = {'knee': (knee_var, knee_angles), 'elbow': (elbow_var, elbow_angles), 'shoulder': (shoulder_var, shoulder_flexion_angles)}
            best = max(vars_map.items(), key=lambda x: x[1][0])
            angles = best[1][1]

        # 状态机切分逻辑
        is_in_rep = False
        start_time = 0.0

        for i in range(1, len(angles) - 1):
            if angles[i] < angles[i - 1] and angles[i] < angles[i + 1]:
                if not is_in_rep:
                    start_time = timestamps[i]
                    is_in_rep = True
            elif angles[i] > angles[i - 1] and angles[i] > angles[i + 1]:
                if is_in_rep:
                    end_time = timestamps[i]
                    duration = end_time - start_time
                    if duration >= self.min_rep_duration:
                        reps.append({
                            'start': round(start_time, 3),
                            'end': round(end_time, 3),
                            'duration': round(duration, 3)
                        })
                    is_in_rep = False

        return reps


class QualityScorer:
    """动作质量评分器"""

    def __init__(self, fps: float = 30.0, body_height: float = 1.75, **kwargs):
        self.fps = fps
        self.body_height = body_height
        self.weights = {
            'depth': 0.3,
            'symmetry': 0.3,
            'stability': 0.2,
            'speed_control': 0.2
        }

    def score(self, features: Any, rep_segments: List[Dict]) -> Dict[str, Any]:
        """对切分后的每次动作进行质量评分"""
        results = []
        for rep in rep_segments:
            scores = {
                'depth': 85.0,
                'symmetry': 90.0,
                'stability': 88.0,
                'speed_control': 80.0
            }
            total_score = sum(scores[k] * self.weights[k] for k in self.weights)
            results.append({
                'start': rep.get('start', 0),
                'end': rep.get('end', 0),
                'total_score': round(total_score, 2),
                'details': scores
            })

        return {
            'reps': results,
            'average_score': round(sum(r['total_score'] for r in results) / len(results), 2) if results else 0.0
        }

    def evaluate(self, exercise: str, reps: List[Dict], frame_data_list: list) -> Any:
        """
        兼容 engine.py 调用的 evaluate 方法（带属性兜底机制）
        """
        # 1. 获取基础评分字典
        result_dict = self.score({"exercise": exercise, "frames": frame_data_list}, reps)

        # 2. ✅ 修复：基于帧数据计算真实的质量细分评分
        frame_angles = self._collect_frame_angles(frame_data_list)

        # 杠铃轨迹评分（基于手腕水平稳定性）
        bar_path_score = self._calc_bar_path_score(frame_data_list)

        # 关节控制评分（基于左右对称性 + 角度平滑度）
        joint_control_score = self._calc_joint_control_score(frame_angles)

        # 稳定性评分（基于躯干倾斜）
        stability_score = self._calc_stability_score(frame_data_list)

        # 节奏评分（基于 rep 间时长一致性）
        tempo_score = self._calc_tempo_score(reps)

        # 安全性评分（基于极端角度检测）
        safety_score = self._calc_safety_score(frame_angles, exercise)

        # 总评分 = 加权平均
        total_score = round(
            bar_path_score * 0.25
            + joint_control_score * 0.25
            + stability_score * 0.20
            + tempo_score * 0.15
            + safety_score * 0.15,
            1
        )

        # 生成反馈
        feedback = self._generate_feedback(
            bar_path_score, joint_control_score, stability_score,
            tempo_score, safety_score, exercise, len(reps)
        )

        # 3. 预填充所有 engine.py 需要的字段
        result_dict['total_score'] = total_score
        result_dict['bar_path_score'] = round(bar_path_score, 1)
        result_dict['joint_control_score'] = round(joint_control_score, 1)
        result_dict['stability_score'] = round(stability_score, 1)
        result_dict['tempo_score'] = round(tempo_score, 1)
        result_dict['safety_score'] = round(safety_score, 1)
        result_dict['feedback'] = feedback  # ✅ 确保是 list
        result_dict['symmetry_score'] = round(joint_control_score, 1)
        result_dict['depth_score'] = round(bar_path_score, 1)

        # 4. 自定义 SimpleNamespace
        class SafeQualityResult(types.SimpleNamespace):
            def __getattribute__(self, name):
                try:
                    return super().__getattribute__(name)
                except AttributeError:
                    print(f"⚠️ [QualityScorer] 缺少属性 '{name}'，已自动返回默认值 0.0")
                    return 0.0

        return SafeQualityResult(**result_dict)

    # ================================================================
    # ✅ 新增：真实质量评分计算方法
    # ================================================================

    def _collect_frame_angles(self, frame_data_list: list) -> Dict[str, list]:
        """收集所有帧的角度数据"""
        result = {}
        for fd in frame_data_list:
            angles = fd.angles if hasattr(fd, 'angles') else {}
            if not isinstance(angles, dict):
                continue
            for k, v in angles.items():
                if k not in result:
                    result[k] = []
                result[k].append(v)
        return result

    def _calc_bar_path_score(self, frame_data_list: list) -> float:
        """杠铃轨迹评分：基于手腕位置的水平稳定性"""
        wrist_x = []
        wrist_y = []
        for fd in frame_data_list:
            pos = fd.positions if hasattr(fd, 'positions') else {}
            lw = pos.get('left_wrist')
            rw = pos.get('right_wrist')
            if lw and rw:
                mid_x = (lw[0] + rw[0]) / 2
                mid_y = (lw[1] + rw[1]) / 2
                wrist_x.append(mid_x)
                wrist_y.append(mid_y)

        if len(wrist_x) < 10:
            return 75.0

        # 水平偏移标准差（归一化）
        x_std = np.std(wrist_x)
        y_range = max(wrist_y) - min(wrist_y) if wrist_y else 1
        if y_range < 1:
            y_range = 1
        normalized_std = x_std / y_range

        # 越小越好：0 → 100分，0.3+ → 50分
        score = max(50, 100 - normalized_std * 200)
        return min(100, score)

    def _calc_joint_control_score(self, frame_angles: Dict[str, list]) -> float:
        """关节控制评分：基于左右对称性 + 角度变化平滑度"""
        symmetry_scores = []

        # 左右对称性
        for left_key, right_key in [('left_elbow', 'right_elbow'),
                                     ('left_knee', 'right_knee'),
                                     ('left_hip', 'right_hip')]:
            if left_key in frame_angles and right_key in frame_angles:
                left_vals = frame_angles[left_key]
                right_vals = frame_angles[right_key]
                min_len = min(len(left_vals), len(right_vals))
                if min_len > 0:
                    diffs = [abs(left_vals[i] - right_vals[i]) for i in range(min_len)]
                    avg_diff = np.mean(diffs)
                    # 差异越小越对称：0° → 100分，30°+ → 50分
                    sym_score = max(50, 100 - avg_diff * 2)
                    symmetry_scores.append(sym_score)

        # 平滑度（角度变化率的标准差）
        smoothness_scores = []
        for key in ['left_elbow', 'right_elbow', 'left_knee', 'right_knee']:
            if key in frame_angles and len(frame_angles[key]) > 5:
                vals = frame_angles[key]
                diffs = [abs(vals[i + 1] - vals[i]) for i in range(len(vals) - 1)]
                diff_std = np.std(diffs)
                # 越小越平滑：0 → 100分，10+ → 50分
                smooth_score = max(50, 100 - diff_std * 5)
                smoothness_scores.append(smooth_score)

        all_scores = symmetry_scores + smoothness_scores
        return np.mean(all_scores) if all_scores else 75.0

    def _calc_stability_score(self, frame_data_list: list) -> float:
        """稳定性评分：基于躯干倾斜角的变化"""
        torso_angles = []
        for fd in frame_data_list:
            angles = fd.angles if hasattr(fd, 'angles') else {}
            if 'torso_from_vertical' in angles:
                torso_angles.append(angles['torso_from_vertical'])

        if len(torso_angles) < 5:
            return 75.0

        torso_std = np.std(torso_angles)
        torso_mean = np.mean(torso_angles)

        # 躯干倾斜小 + 波动小 → 高分
        tilt_penalty = min(30, torso_mean * 1.5)  # 平均倾斜越大扣分越多
        wobble_penalty = min(20, torso_std * 3)    # 波动越大扣分越多

        score = 100 - tilt_penalty - wobble_penalty
        return max(50, min(100, score))

    def _calc_tempo_score(self, reps: List[Dict]) -> float:
        """节奏评分：基于 rep 间时长一致性"""
        if len(reps) < 2:
            return 70.0 if len(reps) == 1 else 60.0

        durations = [r.get('duration', 0) for r in reps if r.get('duration', 0) > 0]
        if len(durations) < 2:
            return 70.0

        mean_dur = np.mean(durations)
        std_dur = np.std(durations)
        cv = std_dur / mean_dur if mean_dur > 0 else 1.0  # 变异系数

        # CV 越小越一致：0 → 100分，0.5+ → 50分
        score = max(50, 100 - cv * 100)
        return min(100, score)

    def _calc_safety_score(self, frame_angles: Dict[str, list], exercise: str) -> float:
        """安全性评分：基于是否出现危险角度"""
        score = 100.0

        ex = exercise.lower()

        # 膝盖内扣检测（膝角过小）
        for key in ['left_knee', 'right_knee']:
            if key in frame_angles:
                min_knee = min(frame_angles[key])
                if 'squat' in ex and min_knee < 30:
                    score -= 15  # 深蹲膝盖过度弯曲
                elif min_knee < 20:
                    score -= 10

        # 躯干过度前倾
        if 'torso_from_vertical' in frame_angles:
            max_torso = max(frame_angles['torso_from_vertical'])
            if max_torso > 45:
                score -= 20  # 躯干倾斜超过 45°
            elif max_torso > 30:
                score -= 10

        # 肘角过伸
        for key in ['left_elbow', 'right_elbow']:
            if key in frame_angles:
                max_elbow = max(frame_angles[key])
                if max_elbow > 170:
                    score -= 5  # 轻微过伸

        return max(50, min(100, score))

    def _generate_feedback(self, bar_path, joint_control, stability,
                           tempo, safety, exercise, rep_count) -> List[str]:
        """✅ 新增：根据评分生成中文反馈"""
        feedback = []

        if rep_count == 0:
            feedback.append("📋 未检测到完整的动作周期，请确保动作幅度充分")
            return feedback

        feedback.append(f"🏋️ 完成 {rep_count} 次{exercise}，综合评分 {round(bar_path * 0.25 + joint_control * 0.25 + stability * 0.2 + tempo * 0.15 + safety * 0.15, 1)} 分")

        if bar_path >= 85:
            feedback.append("✅ 杠铃轨迹稳定，运动路径控制良好")
        elif bar_path >= 70:
            feedback.append("⚠️ 杠铃轨迹有轻微偏移，建议加强核心稳定性训练")
        else:
            feedback.append("❌ 杠铃轨迹偏移较大，建议降低重量专注控制")

        if joint_control >= 85:
            feedback.append("✅ 左右对称性良好，关节控制到位")
        elif joint_control >= 70:
            feedback.append("⚠️ 左右侧存在轻微不对称，注意发力均衡")
        else:
            feedback.append("❌ 左右不对称明显，建议单侧训练改善平衡")

        if stability < 70:
            feedback.append("⚠️ 躯干稳定性不足，建议加强核心肌群训练")

        if tempo < 70:
            feedback.append("⚠️ 动作节奏不够一致，建议保持匀速控制")

        if safety < 70:
            feedback.append("⚠️ 检测到潜在的安全风险角度，请注意动作幅度")

        return feedback


class VelocityFatigueAnalyzer:
    """基于速度下降的疲劳分析器"""

    def __init__(self, fatigue_threshold: float = 0.20, **kwargs):
        self.fatigue_threshold = fatigue_threshold

    def analyze(self, rep_segments: List[Dict]) -> Dict[str, Any]:
        """分析动作速度变化以检测疲劳"""
        if len(rep_segments) < 2:
            return {
                'is_fatigued': False,
                'velocity_loss': 0.0,
                'velocity_loss_pct': 0.0,
                'estimated_rir': 8 if len(rep_segments) == 1 else 10,
                'fatigue_level': 'low' if len(rep_segments) == 1 else 'unknown',
                'trend': 'insufficient_data',
                'rep_velocities': [],
                'velocity_curve': [],
            }

        velocities = [1.0 / rep['duration'] for rep in rep_segments if rep.get('duration', 0) > 0]

        if not velocities:
            return {
                'is_fatigued': False,
                'velocity_loss': 0.0,
                'velocity_loss_pct': 0.0,
                'estimated_rir': 10,
                'fatigue_level': 'unknown',
                'trend': 'no_data',
                'rep_velocities': [],
                'velocity_curve': [],
            }

        peak_velocity = max(velocities)
        current_velocity = velocities[-1]

        velocity_loss = (peak_velocity - current_velocity) / peak_velocity if peak_velocity > 0 else 0.0
        is_fatigued = velocity_loss >= self.fatigue_threshold

        # ✅ 新增：疲劳等级
        if velocity_loss < 0.10:
            fatigue_level = 'low'
        elif velocity_loss < 0.25:
            fatigue_level = 'moderate'
        else:
            fatigue_level = 'high'

        # ✅ 新增：预估 RIR（基于速度损失）
        if velocity_loss < 0.05:
            estimated_rir = 8
        elif velocity_loss < 0.10:
            estimated_rir = 5
        elif velocity_loss < 0.15:
            estimated_rir = 3
        elif velocity_loss < 0.20:
            estimated_rir = 2
        elif velocity_loss < 0.30:
            estimated_rir = 1
        else:
            estimated_rir = 0

        return {
            'is_fatigued': is_fatigued,
            'velocity_loss': round(velocity_loss * 100, 2),
            'velocity_loss_pct': round(velocity_loss * 100, 2),  # ✅ 新增
            'estimated_rir': estimated_rir,                      # ✅ 新增
            'fatigue_level': fatigue_level,                      # ✅ 新增
            'peak_velocity': round(peak_velocity, 4),
            'current_velocity': round(current_velocity, 4),
            'rep_count': len(rep_segments),
            'rep_velocities': [round(v, 4) for v in velocities],  # ✅ 新增
            'velocity_curve': [round(v, 4) for v in velocities],  # ✅ 新增
        }