{
    "meta": {
        "id": "bench_press",
        "name_en": "Barbell Bench Press",
        "name_zh": "杠铃卧推",
        "motion_chain": "upper_body",
        "pattern": "horizontal_push",
        "primary_joints": [
            "shoulder",
            "elbow"
        ],
        "primary_muscles": [
            "胸大肌",
            "三角肌前束",
            "肱三头肌"
        ],
        "equipment": [
            "barbell",
            "bench"
        ],
        "operational_rom_range": {
            "elbow_angle": {
                "min": 50,
                "max": 170,
                "source_type": "heuristic",
                "note": "工程检测范围，非人体标准ROM。实际ROM受臂长、握距、触胸位置、肩胛位置影响。"
            }
        },
        "specification_version": "2.0",
        "specification_type": "domain_heuristic_spec",
        "specification_note": "本文件为产品级启发式规则，非权威生物力学标准。规则来源分为：official_rule（竞赛规则）、research（研究支持）、heuristic（工程经验）、product_policy（产品评分策略）。"
    },
    "phases": {
        "states": [
            "setup",
            "eccentric",
            "concentric",
            "lockout",
            "rest"
        ],
        "transitions": [
            {
                "from": "setup",
                "to": "eccentric",
                "condition": "elbow_angle decreasing AND elbow_angle_decreased > 5",
                "description": "肘角连续下降超过5°，确认开始下放",
                "source_type": "heuristic"
            },
            {
                "from": "eccentric",
                "to": "concentric",
                "condition": "elbow_angle rising_from_min > 3 AND elbow_angle_decreased > 20",
                "description": "【底部事件】肘角从最低点回升>3°，且累计下降>20°（兼容Touch&Go和暂停卧推）",
                "source_type": "heuristic"
            },
            {
                "from": "concentric",
                "to": "lockout",
                "condition": "elbow_angle dropping_from_max > 3 OR elbow_angle stable_for > 0.2s",
                "description": "【顶点事件】肘角从最高点回落>3°，或在高位稳定>0.2s",
                "source_type": "heuristic"
            },
            {
                "from": "lockout",
                "to": "rest",
                "condition": "elbow_angle stable_for > 0.3s",
                "description": "锁定后保持稳定超过0.3秒，进入休息",
                "source_type": "heuristic"
            },
            {
                "from": "rest",
                "to": "eccentric",
                "condition": "elbow_angle decreasing AND elbow_angle_decreased > 5",
                "description": "休息后肘角再次下降超过5°，开始下一次",
                "source_type": "heuristic"
            }
        ],
        "critical_frames": {
            "bottom": {
                "description": "eccentric→concentric 转换帧（bottom_frame），用于检测触胸位置、肘外展、ROM",
                "source_type": "heuristic"
            },
            "top": {
                "description": "concentric→lockout 转换帧（top_frame），用于检测锁死完整性",
                "source_type": "official_rule",
                "reference": "IPF规则要求推起至手臂伸直、肘锁定"
            },
            "sticking_point": {
                "description": "concentric阶段速度最低帧",
                "source_type": "research"
            }
        }
    },
    "key_points": [
        {
            "id": "bar_path",
            "name_zh": "杠铃轨迹",
            "name_en": "Bar Path (Proxy: Wrist Midpoint)",
            "weight": 0.25,
            "source_type": "heuristic",
            "measurement_note": "当前使用wrist_midpoint作为杠铃轨迹代理，非真实杠铃检测。仅在杠铃水平、双手稳定、无明显透视时近似等价。",
            "measure": {
                "method": "wrist_midpoint_trajectory",
                "points": [
                    "left_wrist",
                    "right_wrist"
                ],
                "at_phase": [
                    "eccentric",
                    "concentric"
                ],
                "ideal_path": "下降：肩关节→下胸 斜线; 推起：下胸→肩关节 斜线（J型曲线）"
            },
            "scoring": {
                "excellent": "接近理想J型曲线，水平偏移 < 5%",
                "good": "偏移 5-10%",
                "poor": "偏移 > 15% 或 直上直下"
            },
            "score_map": {
                "deviation_under_5pct": 100,
                "deviation_5_to_10pct": 80,
                "deviation_10_to_15pct": 60,
                "deviation_over_15pct": 35
            },
            "threshold_confidence": "low",
            "threshold_note": "5%/10%/15%偏移阈值为工程经验值，缺乏大样本校准数据。"
        },
        {
            "id": "elbow_tuck",
            "name_zh": "肘部角度",
            "name_en": "Elbow Angle (Tuck vs Flare)",
            "weight": 0.2,
            "source_type": "research",
            "research_note": "研究表明不同肩外展角度会改变肩关节和AC关节负荷，但不存在对所有训练目标都最优的固定角度。45-70°通常被认为是favorable区间，70-90°为context-dependent。",
            "measure": {
                "method": "angle_between",
                "points": [
                    "shoulder",
                    "elbow"
                ],
                "reference": "torso_axis",
                "at_frame": "bottom",
                "ideal": "上臂与躯干夹角 45-70°（favorable区间）"
            },
            "scoring": {
                "excellent": "上臂-躯干角 45-70°（自然内收）",
                "good": "30-45° 或 70-85°",
                "poor": "< 30°（过度夹紧）或 > 85°（明显外展）"
            },
            "score_map": {
                "angle_45_to_70": 100,
                "angle_30_to_45_or_70_to_85": 80,
                "angle_under_30_or_85_to_90": 55,
                "angle_over_90": 25
            },
            "threshold_confidence": "moderate"
        },
        {
            "id": "touch_point",
            "name_zh": "触胸位置",
            "name_en": "Touch Point",
            "weight": 0.15,
            "source_type": "heuristic",
            "measurement_note": "单摄像机2D无法可靠定位'胸骨中下部'。建议使用wrist相对于torso坐标系的纵向位置（shoulder=-1, sternum_ref=0, abdomen=+1），而非绝对胸部区域标签。",
            "measure": {
                "method": "wrist_y_relative_to_shoulder",
                "points": [
                    "wrist_midpoint",
                    "shoulder"
                ],
                "at_frame": "bottom",
                "ideal": "手腕在肩关节下方或略偏下（下胸/胸骨剑突）"
            },
            "scoring": {
                "excellent": "触胸点在胸骨中下部",
                "good": "触胸点略高（中胸）",
                "poor": "触胸点过高（锁骨区）或过低（腹部）"
            },
            "score_map": {
                "lower_chest": 100,
                "mid_chest": 80,
                "upper_chest": 50,
                "neck_or_abs": 25
            },
            "threshold_confidence": "low"
        },
        {
            "id": "symmetry",
            "name_zh": "左右对称性",
            "name_en": "Bilateral Symmetry",
            "weight": 0.2,
            "source_type": "heuristic",
            "prerequisite": "bilateral_valid_ratio >= 0.65",
            "prerequisite_note": "双侧有效数据比例不足0.65时，此指标应为N/A，不得扣分。单侧数据缺失不等于动作不对称。",
            "measure": {
                "method": "compare_sides",
                "points": [
                    "left_elbow_angle",
                    "right_elbow_angle"
                ],
                "at_phase": [
                    "eccentric",
                    "concentric"
                ],
                "rule": "两侧肘角差异 < 10°"
            },
            "scoring": {
                "excellent": "左右肘角差异 < 5°",
                "good": "差异 5-10°",
                "poor": "差异 > 15°"
            },
            "score_map": {
                "diff_under_5": 100,
                "diff_5_to_10": 80,
                "diff_10_to_15": 55,
                "diff_over_15": 25
            },
            "threshold_confidence": "moderate"
        },
        {
            "id": "tempo",
            "name_zh": "动作节奏",
            "name_en": "Tempo Control",
            "weight": 0.2,
            "source_type": "product_policy",
            "policy_note": "不存在对所有训练目标都最佳的固定节奏。力量举、增肌、爆发力、暂停卧推的理想节奏不同。当前阈值针对'通用控制类训练'，未来应改为intent-aware。",
            "measure": {
                "method": "phase_duration_ratio",
                "ideal": {
                    "eccentric": "1.0-3.0s（通用训练参考）",
                    "concentric": "intent-dependent（力量训练偏快，控制训练偏慢）"
                }
            },
            "scoring": {
                "excellent": "下降 1.0-3s + 推起有控制",
                "good": "偏快或偏慢但在合理范围",
                "poor": "下降 < 0.5s（失控）或 完全无控制"
            },
            "score_map": {
                "ideal_tempo": 100,
                "acceptable_tempo": 75,
                "too_fast_eccentric": 40,
                "no_control": 25
            },
            "threshold_confidence": "low"
        }
    ],
    "errors": [
        {
            "id": "bench_incomplete_rom",
            "name_zh": "动作幅度不足",
            "name_en": "Incomplete Range of Motion",
            "severity": "medium",
            "source_type": "official_rule",
            "reference": "IPF规则要求杠铃下放至胸部/腹部区域",
            "risk_note": [
                "肌力发展受限（仅在部分ROM内训练）"
            ],
            "detect": {
                "method": "min_elbow_angle_at_bottom",
                "condition": "bottom_elbow_angle > 90",
                "at_frame": "bottom"
            },
            "severity_levels": {
                "minor": {
                    "threshold": "底部肘角 80-90°",
                    "score_penalty": -5,
                    "penalty_type": "product_policy"
                },
                "moderate": {
                    "threshold": "底部肘角 90-110°（半程）",
                    "score_penalty": -15,
                    "penalty_type": "product_policy"
                },
                "severe": {
                    "threshold": "底部肘角 > 110°（大幅半程）",
                    "score_penalty": -30,
                    "penalty_type": "product_policy"
                }
            },
            "penalty_note": "score_penalty为产品评分策略，不应与Scorer的分层评分重复使用。当前V3 Scorer已将errors设为解释层（deduction=0），不直接扣分。",
            "feedback_zh": "⚠️ 动作幅度不足：杠铃未触胸就开始推起（底部肘角 {angle}°）。降低重量，确保每次杠铃轻触胸部后再推起。",
            "fix_exercises": [
                "暂停卧推",
                "哑铃卧推（更大ROM）",
                "减少重量"
            ]
        },
        {
            "id": "bench_incomplete_lockout",
            "name_zh": "锁定不完整",
            "name_en": "Incomplete Lockout",
            "severity": "low",
            "source_type": "official_rule",
            "reference": "IPF规则要求推起至手臂伸直、肘锁定。注意：训练中刻意不锁肘（健美张力保持）不属于错误。",
            "risk_note": [],
            "detect": {
                "method": "max_elbow_angle_at_top",
                "condition": "top_elbow_angle < 155",
                "at_frame": "top"
            },
            "severity_levels": {
                "minor": {
                    "threshold": "顶部肘角 145-155°",
                    "score_penalty": -3,
                    "penalty_type": "product_policy"
                },
                "moderate": {
                    "threshold": "顶部肘角 < 145°",
                    "score_penalty": -8,
                    "penalty_type": "product_policy"
                }
            },
            "penalty_note": "score_penalty为产品评分策略。注意个体差异：肩活动度受限者顶端肘角可能天然偏低，刻意不锁肘的控制组不应判为错误。",
            "feedback_zh": "⚠️ 手臂未完全伸直：推起最高点肘角仅 {angle}°，尝试在顶部完全锁定肘关节。（如为刻意不锁肘的控制训练可忽略此提示）",
            "fix_exercises": [
                "弹力带卧推",
                "三头肌强化训练"
            ]
        },
        {
            "id": "bench_elbow_flare",
            "name_zh": "肘部过度外展（T型卧推）",
            "name_en": "Elbow Flare",
            "severity": "high",
            "source_type": "research",
            "research_note": "研究表明高肩外展角度与较高肩部机械负荷相关，但不能直接等同为'会受伤'。需结合握距、躯干角度、肩胛位置综合判断。",
            "risk_note": [
                "该姿势与较高肩部机械负荷相关，建议结合个人情况评估"
            ],
            "detect": {
                "method": "angle_at_frame",
                "condition": "upper_arm_torso_angle > 75",
                "at_frame": "bottom"
            },
            "severity_levels": {
                "minor": {
                    "threshold": "外展角 70-80°",
                    "score_penalty": -10,
                    "penalty_type": "product_policy"
                },
                "moderate": {
                    "threshold": "外展角 80-90°",
                    "score_penalty": -25,
                    "penalty_type": "product_policy"
                },
                "severe": {
                    "threshold": "外展角 > 90°（完全T型）",
                    "score_penalty": -40,
                    "penalty_type": "product_policy"
                }
            },
            "penalty_note": "score_penalty为产品评分策略。当前系统尚未实现upper_arm_torso_angle的计算，此规则暂为INSUFFICIENT_DATA。",
            "feedback_zh": "⚠️ 肘部过度外展：上臂与躯干夹角过大（{angle}°），该姿势与较高肩部负荷相关。尝试将肘部向身体方向内收，想象用肘部画箭头而不是T字。",
            "fix_exercises": [
                "哑铃卧推（自然内收）",
                "地板卧推",
                "弹力带拉伸肩关节"
            ]
        },
        {
            "id": "bench_bounce",
            "name_zh": "胸部弹震（砸胸）",
            "name_en": "Chest Bounce",
            "severity": "high",
            "source_type": "heuristic",
            "detection_note": "Touch & Go（轻触即起）与Bounce（砸胸反弹）不能仅靠bottom dwell区分。需联合approach_velocity、bottom_velocity、post-bottom acceleration、direction reversal多信号判断。",
            "risk_note": [
                "失控的弹震可能增加胸部和肩部的冲击负荷",
                "利用弹力反弹会降低目标肌肉的张力持续时间"
            ],
            "detect": {
                "method": "bounce_v34_multi_evidence_detector",
                "version": "V3.4",
                "signals": [
                    "pre_bottom_peak_speed (bottom前0.20s窗口的85th percentile |velocity|，避开极值点附近低速帧)",
                    "post_bottom_peak_speed (bottom后0.20s窗口的85th percentile |velocity|)",
                    "impact_recovery_ratio (post_peak / pre_peak，pre_peak>=80时才计算，>=0.50可疑)",
                    "velocity_drop_ratio (1 - recovery_ratio)",
                    "rebound_latency_frames (bottom→向心速度达pre_peak*40%所需帧数，<=3可疑)",
                    "bottom_dwell_time (基于 near-zero velocity 的真实停留时间)",
                    "direction_reversal_frames (真正计算方向反转用了多少帧)"
                ],
                "logic": {
                    "layer1_context_gate": {
                        "required": "pre_bottom_peak_speed >= 300 °/s",
                        "if_failed": "直接 NOT_DETECTED（接近速度不足以支持 Bounce）"
                    },
                    "layer2_multi_evidence": {
                        "core_principle": "Bounce = 高速接近 + 高速恢复 + 快速反弹 + 短停留（多证据评分，不再依赖单一 ratio 硬门槛）",
                        "impact_score": "fast_approach(+2) / moderate_approach(+1) + high_recovery(+2) + extreme_recovery(+1) + rapid_rebound(+2) + short_dwell(+1) + rapid_reversal(+1)",
                        "severe": "fast_approach(>=400) AND high_recovery(>=0.50) AND (rapid_rebound OR (short_dwell AND rapid_reversal)) AND impact_score>=6",
                        "moderate": "moderate_approach(>=300) AND high_recovery(>=0.50) AND (rapid_rebound OR (short_dwell AND rapid_reversal)) AND impact_score>=4",
                        "touch_and_go": "short_dwell AND rapid_reversal AND NOT high_recovery AND approach<400 (正常训练变式，不报错)",
                        "normal": "其他情况"
                    }
                },
                "thresholds": {
                    "fast_approach": ">=400 °/s (peak speed)",
                    "moderate_approach": ">=300 °/s (peak speed)",
                    "high_recovery": ">=0.50",
                    "extreme_recovery": ">=0.65",
                    "rapid_rebound_latency": "<=3 frames",
                    "bottom_dwell": "<=0.08s",
                    "reversal_frames": "<=2",
                    "recovery_pre_peak_gate": "pre_peak >= 80 °/s 时才计算 recovery_ratio",
                    "rebound_latency_target": "向心速度达 max(80, pre_peak*0.40) °/s"
                },
                "v3.4_fixes": [
                    "修复V3.3漏检：recovery=0.55<0.75导致462°/s+0ms+1f被判成Touch&Go",
                    "recovery门槛从0.75降到0.50(high)/0.65(extreme)，不再作为硬门槛",
                    "approach门槛从180/250改成300/400(用peak speed)",
                    "新增rebound_latency_frames(bottom→向心速度达pre_peak*40%所需帧数)，比direction_reversal_frames强很多",
                    "用impact_score多证据评分(满分10)，不再依赖单一recovery ratio",
                    "产品文案用'疑似砸胸/弹胸'而非'确认砸胸'(单目2D无法真正证明撞击)",
                    "删除已deprecated的_compute_rebound_ratio函数，避免信号源不一致"
                ],
                "deprecated_signals": [
                    "bottom_acceleration (仍计算但不再作为Bounce判定依据，噪声太大)",
                    "direction_reversal_frames (仍计算但信息量低，被rebound_latency_frames替代为主)"
                ],
                "at_frame": "bottom"
            },
            "severity_levels": {
                "minor": {
                    "threshold": "底部停顿 < 0.1s 且接近速度正常",
                    "score_penalty": -10,
                    "penalty_type": "product_policy"
                },
                "moderate": {
                    "threshold": "明显弹震（高接近速度+快速反转）",
                    "score_penalty": -25,
                    "penalty_type": "product_policy"
                },
                "severe": {
                    "threshold": "快速砸胸反弹（极高接近速度+异常高推起速度）",
                    "score_penalty": -40,
                    "penalty_type": "product_policy"
                }
            },
            "penalty_note": "score_penalty为产品评分策略。Touch & Go是合法的训练变式，不应等同于bounce。",
            "feedback_zh": "⚠️ 底部弹震：杠铃触胸后利用弹力反弹推起，缺乏控制。如需练习控制，可尝试暂停卧推（触胸后停顿1-2秒）；Touch & Go（轻触即起）是合法的训练变式，不等于弹震。",
            "fix_exercises": [
                "暂停卧推（2-3秒停顿）",
                "Spoto Press",
                "哑铃卧推"
            ]
        },
        {
            "id": "bench_butt_off_bench",
            "name_zh": "臀部离凳",
            "name_en": "Buttocks Lift Off Bench",
            "severity": "medium",
            "source_type": "official_rule",
            "reference": "IPF规则要求臀部始终与凳面接触。适度起桥（arch）是合法的，只要臀部不离凳。",
            "detection_note": "应区分arch（起桥，臀部仍接触凳面）和butt-off（臀部离凳）。不能仅靠hip_y高度判断。",
            "risk_note": [
                "臀部离凳会改变力传递路径，可能增加下背应变"
            ],
            "detect": {
                "method": "pose_relative_pelvis_lift",
                "signals": [
                    "pelvis_center_y",
                    "shoulder_center_y",
                    "setup_baseline",
                    "relative_lift = Δpelvis_y - 0.5 * Δshoulder_y",
                    "persistence_frames"
                ],
                "condition": "relative_lift > max(15px, 0.05 * torso_length) AND persistence >= 0.15s",
                "at_phase": "concentric",
                "states": [
                    "normal_arch",
                    "suspected_lift",
                    "confirmed_lift",
                    "insufficient_data"
                ],
                "limitation": "V1 仅用 Pose，无法检测 bench plane。主要输出 suspected_lift，confirmed_lift 需 V2（bench plane detection）。"
            },
            "severity_levels": {
                "minor": {
                    "threshold": "臀部轻微抬起（仍接触）",
                    "score_penalty": -10,
                    "penalty_type": "product_policy"
                },
                "moderate": {
                    "threshold": "臀部明显离凳",
                    "score_penalty": -20,
                    "penalty_type": "product_policy"
                },
                "severe": {
                    "threshold": "臀部大幅离凳",
                    "score_penalty": -35,
                    "penalty_type": "product_policy"
                }
            },
            "penalty_note": "score_penalty为产品评分策略。当前2D单目视觉难以可靠检测臀部是否离凳，此规则可能需要侧视角或深度信息。",
